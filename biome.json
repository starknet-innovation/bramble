{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!.impeccable",
      "!.playwright-cli",
      "!apps/terminal",
      "!apps/ui-lab",
      "!bun.lock",
      "!dist",
      "!node_modules",
      "!output",
      "!playwright-report",
      "!test-results",
      "!vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 35
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": {
          "level": "error",
          "options": {
            "propertyAssignment": "deny"
          }
        },
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "vcs": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "apps/extension/src/background/**",
        "apps/extension/src/provider/**",
        "packages/foundation/core/src/**",
        "packages/foundation/wallet-model/src/**",
        "packages/foundation/wallet-protocol/src/**",
        "packages/platform/store/src/**",
        "packages/platform/vault/src/**",
        "packages/platform/kms-krusty/src/**",
        "packages/platform/ledger-browser/src/**",
        "packages/platform/ledger-protocol/src/**",
        "packages/platform/starknet/src/**",
        "packages/features/privacy/src/**",
        "packages/features/multisig/src/**",
        "packages/features/portfolio/src/**",
        "packages/features/permissions/src/**",
        "packages/features/transactions/src/**",
        "packages/features/settings/src/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 12
              }
            }
          }
        }
      }
    }
  ]
}
