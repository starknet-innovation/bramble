#[test]
fn bench_baseline_worst_sampled() {
    let pk = public_key();
    let sig = worst_signature();
    assert!(pk.len() == 2 && sig.len() == 491);
}

#[test]
fn bench_verify_worst_sampled() {
    assert!(
        SlhDsaBlake2s128sVerifier::verify(705607733040121594031952765554288293081996107061139872658393799090773149371, public_key().span(), worst_signature().span()),
    );
}
