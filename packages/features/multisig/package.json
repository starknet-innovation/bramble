{
  "name": "@bramble/multisig",
  "description": "Argent multisig: pinned configuration reads, deployment construction, exact-hash signing-intent validation, signature collection and public repository persistence.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./chain": "./src/chain.ts",
    "./coordination": "./src/coordination.ts",
    "./deploy": "./src/deploy.ts",
    "./repository": "./src/repository.ts",
    "./signer-account": "./src/signer-account.ts"
  },
  "scripts": {
    "check": "bun run check:types && bun run test",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --preload ../../../tests/support/test-preload.ts ./tests"
  },
  "dependencies": {
    "@bramble/core": "workspace:*",
    "@bramble/starknet": "workspace:*",
    "@bramble/store": "workspace:*",
    "@bramble/wallet-model": "workspace:*",
    "starknet": "10.8.0"
  }
}
