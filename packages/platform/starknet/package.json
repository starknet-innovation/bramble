{
  "name": "@bramble/starknet",
  "description": "Generic Starknet RPC transport, timeout and failover, RPC response validation, call and value serialization, fee and resource primitives, and signer adaptation.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./account-contracts": "./src/accounts/account-contracts.ts",
    "./class-hash-verify": "./src/transactions/class-hash-verify.ts",
    "./declare": "./src/transactions/declare.ts",
    "./deployment": "./src/transactions/deployment.ts",
    "./fee-bounds": "./src/rpc/fee-bounds.ts",
    "./multisig-invoke": "./src/rpc/multisig-invoke.ts",
    "./provider": "./src/rpc/provider.ts",
    "./rpc-diagnostics": "./src/rpc/rpc-diagnostics.ts",
    "./rpc-transport": "./src/rpc/rpc-transport.ts",
    "./rpc": "./src/rpc/rpc.ts",
    "./rpc-assets": "./src/rpc/rpc-assets.ts",
    "./rpc-submit": "./src/rpc/rpc-submit.ts",
    "./signature-verify": "./src/transactions/signature-verify.ts",
    "./snip12-merkle": "./src/transactions/snip12-merkle.ts",
    "./snip12-scalars": "./src/transactions/snip12-scalars.ts",
    "./snip12-vocabulary": "./src/transactions/snip12-vocabulary.ts",
    "./stark-name": "./src/rpc/stark-name.ts",
    "./typed-data": "./src/transactions/typed-data.ts"
  },
  "scripts": {
    "check": "bun run check:types && bun run test",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --preload ../../../tests/support/test-preload.ts ./tests"
  },
  "dependencies": {
    "@bramble/core": "workspace:*",
    "@bramble/wallet-model": "workspace:*",
    "@bramble/wallet-protocol": "workspace:*",
    "starknet": "10.8.0"
  }
}
