{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"]
    },
    "apps/extension": {
      "entry": [
        "src/background/index.ts",
        "src/content/index.ts",
        "src/ledger-grant/index.ts",
        "src/pq-grant/index.ts",
        "src/provider/inpage.ts",
        "src/sandbox/render.ts",
        "src/sidepanel/index.ts"
      ],
      "ignoreDependencies": ["buffer"],
      "ignoreUnresolved": ["/dependencies/krusty-kms/krusty_kms_wasm.js"],
      "project": ["src/**/*.ts"]
    },
    "apps/terminal": {
      "entry": ["api/**/*.ts", "scripts/*.ts"],
      "project": ["api/**/*.ts", "scripts/**/*.ts", "src/**/*.{ts,tsx}"]
    },
    "apps/ui-lab": {
      "entry": [".storybook/*.ts", "src/**/*.stories.ts"],
      "project": [".storybook/*.ts", "src/**/*.ts"]
    },
    "packages/platform/ledger-browser": {
      "ignoreDependencies": ["buffer"]
    }
  }
}
