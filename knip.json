{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "ignoreBinaries": ["scarb"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"]
    },
    "apps/extension": {
      "entry": [
        "src/background/index.ts",
        "src/content/index.ts",
        "src/ledger-grant/index.ts",
        "src/provider/inpage.ts",
        "src/sandbox/render.ts",
        "src/sidepanel/index.ts"
      ],
      "ignoreDependencies": ["buffer"],
      "project": ["src/**/*.ts"]
    },
    "apps/terminal": {
      "entry": ["api/**/*.ts"]
    },
    "packages/platform/ledger-browser": {
      "ignoreDependencies": ["buffer"]
    }
  }
}
