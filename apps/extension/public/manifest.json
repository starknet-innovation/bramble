{
  "manifest_version": 3,
  "name": "Bramble: Starknet Wallet",
  "version": "0.10.0",
  "description": "Starknet browser extension wallet shell.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Open Bramble"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: https:; frame-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; frame-src blob:; base-uri 'none'; form-action 'none'"
  },
  "sandbox": {
    "pages": ["sandbox/render.html"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["alarms", "sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://wallet.nodes.starknet.org/*",
    "https://mainnet.nodes.starknet.org/*",
    "https://sepolia.nodes.starknet.org/*",
    "https://api.cartridge.gg/*",
    "https://api.coingecko.com/*",
    "https://starkscan.co/*",
    "https://starknet.api.avnu.fi/*",
    "https://sepolia.api.avnu.fi/*",
    "https://metamask.github.io/*",
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "web_accessible_resources": [
    {
      "resources": ["provider/inpage.js"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}
