{
  "name": "@bramble/ui-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "storybook build",
    "check": "bun run check:types && bun run check:lint && bun run test",
    "check:lint": "biome check .",
    "check:static": "bun run check:types && bun run check:lint",
    "check:types": "tsc --noEmit",
    "chromatic": "chromatic --exit-zero-on-changes --only-changed",
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run --project=storybook"
  },
  "dependencies": {
    "@bramble/core": "workspace:*",
    "@bramble/ledger-protocol": "workspace:*",
    "@bramble/multisig": "workspace:*",
    "@bramble/privacy": "workspace:*",
    "@bramble/settings": "workspace:*",
    "@bramble/starknet": "workspace:*",
    "@bramble/transactions": "workspace:*",
    "@bramble/ui-kit": "workspace:*",
    "@bramble/wallet-ui": "workspace:*",
    "@bramble/wallet-model": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/html-vite": "10.5.10",
    "@types/react": "19.2.18",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/runner": "4.1.11",
    "chromatic": "18.7.0",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
