// Cloudflare Worker that serves the built Bramble website.
//
// This is an assets-only Worker: there is no `main` script, so every request is
// answered from `dist/` by Cloudflare's static-asset routing and nothing runs
// server-side. `.github/workflows/website-deploy.yml` builds `dist/` and runs
// `wrangler deploy` against this file; the deploy only reaches the live site
// because `name` matches the existing Worker. Deploying under any other name
// creates a second Worker and silently leaves the live hostname stale.
{
  "name": "bramble",
  // Matches the date already set on the live Worker, so deploying this config
  // does not move a runtime setting for no reason.
  "compatibility_date": "2026-09-01",
  // The site is reachable on its own hostname only. Disabling the workers.dev
  // hostname and preview URLs keeps a wallet site from being reachable on a
  // second, unbranded origin that phishing pages could imitate or link to.
  "workers_dev": false,
  "preview_urls": false,
  // The public hostname. A Workers custom domain requires the zone to be served
  // by Cloudflare DNS, so bramble.fi's nameservers must point at Cloudflare even
  // though it is registered through Route 53 — a deploy fails at the attach step
  // while the zone is anywhere else. bramble.money is deliberately absent: it
  // was retired, and declaring only the current hostname is what stops a deploy
  // re-attaching the old one.
  "routes": [{ "pattern": "bramble.fi", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Vite emits real entry documents at /, /docs/, /support/, and /privacy/;
    // `auto-trailing-slash` serves each `index.html` at its directory path and
    // redirects the slash-less form. Anything else is a genuine 404 — there is
    // deliberately no single-page-application fallback, because it would answer
    // every mistyped URL on a wallet domain with the home page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
