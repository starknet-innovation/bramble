{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_AVNU_MARKETS_BASE=/proxy/avnu-markets VITE_EXTENDED_REST_BASE=/proxy/extended/api/v1 VITE_STARKSCAN_BASE=/proxy/starkscan/v1/SN_MAIN bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'self' https://api.cartridge.gg https://mainnet.nodes.starknet.org https://api.vesu.xyz https://prod-api.ekubo.org https://prod-api-quoter.ekubo.org https://starknet.api.avnu.fi https://starknet.impulse.avnu.fi https://starkscan.co https://api.starknet.extended.exchange wss://api.starknet.extended.exchange; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        {
          "key": "Permissions-Policy",
          "value": "bluetooth=(), camera=(), geolocation=(), hid=(), microphone=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/proxy/avnu-markets/:path*",
      "destination": "https://starknet.impulse.avnu.fi/:path*"
    },
    {
      "source": "/proxy/extended/:path*",
      "destination": "https://api.starknet.extended.exchange/:path*"
    },
    {
      "source": "/proxy/starkscan/:path*",
      "destination": "https://starkscan.co/:path*"
    },
    {
      "source": "/api/strk20/:service",
      "destination": "/api/strk20/gateway?service=:service"
    },
    {
      "source": "/api/strk20/:service/:path*",
      "destination": "/api/strk20/gateway?service=:service&path=:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
