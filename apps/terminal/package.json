{
  "name": "@bramble/terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bramble Trade Terminal — a standalone Starknet trade terminal that connects to the Bramble browser extension as a dApp.",
  "scripts": {
    "dev": "vite",
    "dev:full": "bunx vercel@58.9.1 dev",
    "dev:gateway": "bun run scripts/dev-strk20-gateway.ts",
    "build": "tsc --noEmit && vite build",
    "build:contract": "bun run scripts/build-punk-contract.ts",
    "assets:avnu": "bun run scripts/sync-avnu-token-assets.ts",
    "assets:extended": "bun run scripts/sync-extended-token-assets.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:api": "bun run scripts/check-api.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@avnu/avnu-sdk": "4.2.0",
    "@bramble/wallet-model": "workspace:*",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "starknet": "10.8.0"
  },
  "devDependencies": {
    "@bramble/testkit": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
