{
  "name": "@mc-wallet/terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MC Wallet Trade Terminal — a standalone Starknet trade terminal that connects to the MC Wallet browser extension as a dApp.",
  "scripts": {
    "dev": "vite",
    "dev:full": "bunx vercel@58.9.1 dev",
    "dev:gateway": "bun run scripts/dev-strk20-gateway.ts",
    "build": "tsc --noEmit && vite build",
    "build:contract": "bun run scripts/build-punk-contract.ts",
    "assets:avnu": "bun run scripts/sync-avnu-token-assets.ts",
    "assets:extended": "bun run scripts/sync-extended-token-assets.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:api": "bun run scripts/check-api.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@avnu/avnu-sdk": "4.2.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "1.31.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "starknet": "10.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "25.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "ws": "8.21.0"
  }
}
