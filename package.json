{
  "name": "mc-wallet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "bun run scripts/build-extension.ts",
    "check": "bun run check:types && bun run check:lint && bun run check:files && bun run check:extension && bun run check:krusty && bun test",
    "check:extension": "bun run scripts/check-extension-manifest.ts",
    "check:files": "bun run scripts/check-file-standards.ts && bun run scripts/check-config-standards.ts",
    "check:krusty": "bun run scripts/check-krusty-adapter.ts",
    "check:lint": "biome check .",
    "check:types": "tsc --noEmit",
    "format": "biome check --write .",
    "package:extension": "bun run scripts/package-extension.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:build": "bun run build && bun run test:e2e",
    "test:e2e:install": "playwright install --with-deps chromium",
    "vendor:krusty": "bun run scripts/vendor-krusty.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "starknet": "10.0.2"
  }
}
